# ============================================================
#  فقط برای اجرای روی کامپیوتر خودتان لازم است.
#  اگر روی GitHub Actions اجرا می‌کنید، به‌جای این فایل از
#  Settings ← Secrets and variables ← Actions استفاده کنید.
#
#  این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
#  .env را هرگز در گیت‌هاب آپلود نکنید.
# ============================================================

# ============================================================
#  حالت buffer (پیش‌فرض) — این سه بخش لازم است
# ============================================================

# --- مدل زبانی (ضروری) ---
# کلید سرویس مدل زبانی. سرویس و نام مدل را در config.yaml بخش llm بگذارید.
# این متغیر با هر ارائه‌دهنده‌ای کار می‌کند.
LLM_API_KEY=

# --- بافر (ضروری در حالت buffer) ---
# از publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=

# --- میزبانی تصویر روی گیت‌هاب (ضروری) ---
# بافر تصویر را از یک آدرس عمومی برمی‌دارد.
# روی GitHub Actions خودکار ساخته می‌شود؛ فقط برای اجرا روی کامپیوتر خودتان
# یک Personal Access Token با دسترسی Contents لازم است.
GH_TOKEN=

# --- تلگرام (اختیاری — فقط برای گزارش) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
#  فقط برای حالت api — اگر به پلتفرم متا دسترسی ندارید، رد کنید
# ============================================================

# توکن دسترسی بلندمدت (۶۰ روزه)
IG_ACCESS_TOKEN=
# شناسه عددی اکانت — خالی بگذارید، خودش از روی توکن پیدا می‌کند
IG_USER_ID=

# --- میزبانی روی S3 (فقط اگر provider=s3) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- تمدید کاملاً خودکار توکن (اختیاری) ---
# یک Personal Access Token با دسترسی Secrets: read & write
GH_PAT=
